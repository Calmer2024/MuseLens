# 复制为仓库根目录的 .env 后，docker compose 会自动用这里的变量替换 compose 文件中的 ${...}
#   copy .env.docker.example .env   （Windows PowerShell: Copy-Item .env.docker.example .env）

# ---------- Docker 构建：pip 源（backend 镜像构建时传给 Dockerfile）----------
# 默认清华镜像；若需官方 PyPI：PIP_INDEX_URL=https://pypi.org/simple
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------- PostgreSQL（与 docker-compose.backend.yml 默认一致）----------
MUSELENS_POSTGRES_PASSWORD=123cfx
MUSELENS_POSTGRES_PORT=5433

# ---------- 后端端口 ----------
MUSELENS_BACKEND_PORT=8000

# ---------- LLM（Planner / Router）----------
MUSELENS_LLM_BASE_URL=https://api.openai.com/v1
MUSELENS_LLM_API_KEY=
MUSELENS_LLM_MODEL=
MUSELENS_LLM_TIMEOUT_S=60

# ---------- ComfyUI 在「宿主机」上监听 8188 时，容器内通过 host.docker.internal 访问 ----------
MUSELENS_COMFY_NETLOC=host.docker.internal:8188

# ---------- 可选：Comfy 目录映射到宿主机（需自行挂载 volume 时再改）----------
# COMFYUI_OUTPUT_DIR=/tmp/comfyui/output
# COMFYUI_INPUT_DIR=/tmp/comfyui/input

# ---------- pytest：宿主机跑测试时用 127.0.0.1:5433；容器内已默认用主机名 postgres ----------
# （容器内）compose 已为 backend 设置 MUSELENS_TEST_POSTGRES_DSN，一般无需再配。
# （宿主机）在 backend/.env 或 shell 中：
# MUSELENS_TEST_POSTGRES_DSN=postgresql://postgres:123cfx@127.0.0.1:5433/postgres
# MUSELENS_PG_DSN=postgresql://postgres:123cfx@127.0.0.1:5433/muselens
