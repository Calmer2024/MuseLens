# Copy this file to repo-root `.env` before starting the stack.
# PowerShell:
#   Copy-Item .env.docker.example .env

# ---------- Docker build ----------
# Optional: switch to official PyPI when needed.
# PIP_INDEX_URL=https://pypi.org/simple

# ---------- Core ----------
TZ=Asia/Shanghai
PUBLIC_API_BASE_URL=https://api.example.com
SIGNED_URL_EXPIRE_SECONDS=3600

# ---------- PostgreSQL ----------
MUSELENS_POSTGRES_PASSWORD=123cfx
MUSELENS_POSTGRES_PORT=5433
MUSELENS_POSTGRES_DATA_DIR=/data/muselens/postgres

# ---------- Backend ----------
MUSELENS_BACKEND_PORT=8000
MUSELENS_BACKEND_TMP_DIR=/data/muselens/backend-tmp

# ---------- LLM ----------
MUSELENS_LLM_BASE_URL=https://api.openai.com/v1
MUSELENS_LLM_API_KEY=
MUSELENS_LLM_MODEL=
MUSELENS_LLM_TIMEOUT_S=60

# ---------- MinIO ----------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-now
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MUSELENS_MINIO_DATA_DIR=/data/muselens/minio
MUSELENS_MINIO_ENDPOINT=minio:9000
MUSELENS_MINIO_PUBLIC_ENDPOINT=
MUSELENS_MINIO_ACCESS_KEY=admin
MUSELENS_MINIO_SECRET_KEY=change-me-now
MUSELENS_MINIO_SECURE=false
MUSELENS_MINIO_PUBLIC_SECURE=true
MUSELENS_MINIO_BUCKET_INPUT=muselens-input
MUSELENS_MINIO_BUCKET_OUTPUT=muselens-output
MUSELENS_MINIO_BUCKET_TEMP=muselens-temp

# ---------- FC Adapter / ComfyUI ----------
MUSELENS_FC_ADAPTER_BASE_URL=http://fc-adapter:8080
MUSELENS_FC_ADAPTER_TOKEN=
MUSELENS_FC_ADAPTER_TIMEOUT_S=600
# Base URL of the FC-hosted ComfyUI service, used by fc-adapter.
MUSELENS_FC_COMFY_BASE_URL=

# ---------- Nginx / HTTPS ----------
MUSELENS_NGINX_CERT_DIR=/data/muselens/nginx/certs

# ---------- pytest ----------
# Host-side examples:
# MUSELENS_TEST_POSTGRES_DSN=postgresql://postgres:123cfx@127.0.0.1:5433/postgres
# MUSELENS_PG_DSN=postgresql://postgres:123cfx@127.0.0.1:5433/muselens
