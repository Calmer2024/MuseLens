{
  "lens_id": "lens_watermark",
  "layer": "A5",
  "description": "A5 水印与版权保护：在最终图像上叠加签名、品牌名或版权说明，完成可交付成片的标识保护。",
  "workflow_file": "lens_watermark.json",
  "inputs": [
    {
