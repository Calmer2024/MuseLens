      "mapping": { "node_id": "16", "field_name": "value" }
    },
    {
      "name": "width",
      "type": "int",
      "description": "生成图像宽度。",
      "mapping": { "node_id": "6", "field_name": "value" }
    },
    {
      "name": "height",
      "type": "int",
      "description": "生成图像高度。",
      "mapping": { "node_id": "7", "field_name": "value" }
    },
    {
      "name": "steps",
      "type": "int",
      "description": "控制采样步数。",
      "mapping": { "node_id": "2", "field_name": "steps" }
    },
    {
      "name": "cfg",
      "type": "float",
      "description": "控制文本提示对生成结果的引导强度。",
      "mapping": { "node_id": "3", "field_name": "cfg" }
    },
    {
      "name": "noise_seed",
      "type": "int",
