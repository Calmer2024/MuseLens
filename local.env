# ---------------- Database (PostgreSQL) ----------------
# 与仓库根目录 docker-compose.backend.yml 一致：宿主机端口 5433 → 容器 5432
# 请先执行：docker compose -f docker-compose.backend.yml up -d
MUSELENS_DB_URL=postgresql+psycopg://postgres:123cfx@127.0.0.1:5433/muselens

# ---------------- pytest：集成测试连「宿主机上的」compose Postgres（建临时库用 admin 库 postgres）----------------
MUSELENS_TEST_POSTGRES_DSN=postgresql://postgres:123cfx@127.0.0.1:5433/postgres

# ---------------- LLM Planner ----------------
MUSELENS_LLM_BASE_URL=https://api.siliconflow.cn/v1
MUSELENS_LLM_API_KEY=sk-wkqnpmunuokhsuninekpebxrmpqokluhjqcquhctortoaiyv
MUSELENS_LLM_MODEL=Pro/zai-org/GLM-4.7
MUSELENS_LLM_TIMEOUT_S=30

# 设为 1 时运行「真实调用 LLM」的测试（如 test_planner_service_real_llm）；默认不设或 0 则跳过
MUSELENS_TEST_REAL_LLM=0

# ---------------- RAG (pgvector) ----------------
MUSELENS_RAG_BACKEND=pgvector
# 与业务库同一实例即可（表 lens_embeddings 会建在 muselens 库）
MUSELENS_PG_DSN=postgresql://postgres:123cfx@127.0.0.1:5433/muselens
MUSELENS_RAG_PGVECTOR_TABLE=lens_embeddings

# ---------------- ComfyUI paths ----------------
COMFYUI_OUTPUT_DIR=D:\soft\AI\ComfyUI_windows_portable\ComfyUI\output
COMFYUI_INPUT_DIR=D:\soft\AI\ComfyUI_windows_portable\ComfyUI\input